{
  "name": "jinjin",
  "version": "0.3.0",
  "description": "A tiny, dependency-free color engine: parsing, RGB/HSV/HSL/OKLCH conversion, harmonies, manipulation and WCAG contrast.",
  "type": "module",
  "main": "./dist/jin.umd.cjs",
  "module": "./dist/jin.js",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./dist/jin.js",
      "require": "./dist/jin.umd.cjs"
    }
  },
  "unpkg": "./dist/jin.umd.cjs",
  "jsdelivr": "./dist/jin.umd.cjs",
  "files": [
    "dist",
    "types",
    "README.MD"
  ],
  "sideEffects": false,
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --config vite.umd.config.js",
    "build:demo": "vite build --config vite.demo.config.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run test && npm run build"
  },
  "repository": "git@github.com:cwj0417/jin.git",
  "author": "chenwj <731028571@qq.com>",
  "license": "MIT",
  "keywords": [
    "color",
    "palette",
    "oklch",
    "hsl",
    "hsv",
    "wcag",
    "contrast",
    "color-scheme"
  ],
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  }
}
